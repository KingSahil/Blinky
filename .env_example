GROQ_API_KEY=
BLINKY_GROQ_MODEL=qwen/qwen3.8-27b
CLICKY_GROQ_MODEL=qwen/qwen3.8-27b
CLICKY_GROQ_URL=https://api.groq.com/openai/v1/chat/completions
BLINKY_AI_PROVIDER=groq
# Vercel accessibility/ref backends (see docs/vercel-agents.md).
BLINKY_DESKTOP_ENGINE=agent-desktop
BLINKY_BROWSER_ENGINE=agent-browser
# Optional existing browser CDP endpoint; otherwise auto-discover Chrome.
# BLINKY_BROWSER_CDP_URL=http://127.0.0.1:9222
BLINKY_SHORTCUT=Space
SARVAM_API_KEY=
DEEPSEEK_API_KEY=
ASSEMBLY_AI_API_KEY=

# ESP32 Hardware Integration
ESP32_WIFI_SSID=YOUR_WIFI_SSID
ESP32_WIFI_PASSWORD=YOUR_WIFI_PASSWORD
ESP32_HOST=192.168.1.4

# RevenueCat Paywall & In-App Purchases (Mobile)
EXPO_PUBLIC_REVENUECAT_GOOGLE_KEY=goog_your_public_api_key_here
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=pc_access
# Custom Promo Codes for direct distribution (comma-separated bypass codes)
EXPO_PUBLIC_PROMO_CODES=SHIPATHON,BLINKYVIP,EARLYBIRD
