{
  "cli": {
    "version": ">= 10.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_BLINKY_TRANSPORT_MODE": "development"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "release": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_BLINKY_TRANSPORT_MODE": "release"
      }
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_BLINKY_TRANSPORT_MODE": "release"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
